<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:animation_enabled="false"
        app:buffered_color="@color/white_40"
        app:controller_layout_id="@layout/player_controls"
        app:fastforward_icon="@drawable/ic_forward"
        app:keep_content_on_player_reset="true"
        app:pause_icon="@drawable/ic_pause"
        app:play_icon="@drawable/ic_play"
        app:played_color="@color/white"
        app:rewind_icon="@drawable/ic_rewind"
        app:scrubber_color="@color/white"
        app:show_buffering="when_playing"
        app:show_timeout="4000"
        app:shutter_background_color="@color/black"
        app:unplayed_color="@color/white_20" />

    <LinearLayout
        android:id="@+id/empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:alpha="0.6"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_movie" />

        <TextView
            android:id="@+id/empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:maxWidth="560dp"
            android:text="@string/empty_message"
            android:textColor="@color/white_60"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="@dimen/panel_width"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginVertical="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/panel_background"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/panel_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:text="@string/settings"
            android:textColor="@color/white_55"
            android:textSize="13sp" />

        <ScrollView
            android:id="@+id/panel_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/panel_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
