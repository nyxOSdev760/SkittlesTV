<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/row_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="50dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="11dp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="@dimen/row_icon"
        android:layout_height="@dimen/row_icon"
        android:layout_marginEnd="16dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:tint="@color/row_content" />

    <TextView
        android:id="@+id/row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/row_content"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxWidth="170dp"
        android:singleLine="true"
        android:textColor="@color/row_value"
        android:textSize="14sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/row_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check"
        android:tint="@color/row_content"
        android:visibility="gone" />
</LinearLayout>
