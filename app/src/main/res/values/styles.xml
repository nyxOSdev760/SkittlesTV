<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ControlButton">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/control_background</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/control_tint</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TimeText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
